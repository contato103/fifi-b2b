      "title": "CNPJ",
      "graphCoordinates": {
        "x": 2040,
        "y": 0
      },
      "blocks": [
        {
          "id": "b-cnpj-q",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "E o CNPJ da loja? As condições de revenda são para lojas com CNPJ ativo."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "b-cnpj-in",
          "type": "text input",
          "options": {
            "labels": {
              "placeholder": "00.000.000/0000-00",
              "button": "Enviar"
            },
            "variableId": "v_cnpj",
            "isLong": false
          }
        },
        {
          "id": "b-cnpj-check",
          "type": "Set variable",
          "options": {
            "variableId": "v_cnpj_valido",
            "isExecutedOnClient": true,
            "expressionToEvaluate": "var d=(\"\"+({{cnpj}}||\"\")).replace(/\\D/g,\"\").slice(0,14);if(d.length!==14||/^(\\d)\\1{13}$/.test(d))return\"nao\";function dv(b){var p=b.length-7,s=0;for(var i=0;i<b.length;i++){s+=(+b[i])*p;p=p===2?9:p-1}var r=s%11;return r<2?0:11-r}return (dv(d.slice(0,12))===+d[12]&&dv(d.slice(0,13))===+d[13])?\"sim\":\"nao\";",
            "isCode": true,
            "type": "Custom"
          }
        },
        {
          "id": "b-cnpj-cond",
          "outgoingEdgeId": "e-cnpj-erro",
          "type": "Condition",
          "items": [
            {
              "id": "cnpj-sim",
              "outgoingEdgeId": "e-cnpj",
              "content": {
                "logicalOperator": "AND",
                "comparisons": [
                  {
                    "id": "cnpj-sim-cmp",
                    "variableId": "v_cnpj_valido",
                    "comparisonOperator": "Equal to",
                    "value": "sim"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
