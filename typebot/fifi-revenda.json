        {
          "id": "b-fbp",
          "type": "Set variable",
          "options": {
            "variableId": "v_fbp",
            "isExecutedOnClient": true,
            "expressionToEvaluate": "function gc(n){var m=document.cookie.match(new RegExp('(^| )'+n+'=([^;]+)'));return m?decodeURIComponent(m[2]):''} return gc('_fbp')",
            "isCode": true,
            "type": "Custom"
          }
        },
        {
          "id": "b-fbc",
          "type": "Set variable",
          "options": {
            "variableId": "v_fbc",
            "isExecutedOnClient": true,
            "expressionToEvaluate": "function gc(n){var m=document.cookie.match(new RegExp('(^| )'+n+'=([^;]+)'));return m?decodeURIComponent(m[2]):''} var c=gc('_fbc');if(!c){var f={{fbclid}}||new URLSearchParams(location.search).get('fbclid');if(f)c='fb.1.'+Date.now()+'.'+f}return c",
            "isCode": true,
            "type": "Custom"
          }
        },
        {
          "id": "b-event",
          "type": "Set variable",
          "options": {
            "variableId": "v_event_id",
            "isExecutedOnClient": true,
            "expressionToEvaluate": "return (window.crypto&&crypto.randomUUID)?crypto.randomUUID():'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,function(c){var r=Math.random()*16|0;return (c==='x'?r:(r&0x3|0x8)).toString(16)})",
            "isCode": true,
            "type": "Custom"
          }
        },
        {
          "id": "b-pagina",
          "type": "Set variable",
          "options": {
            "variableId": "v_pagina",
            "isExecutedOnClient": true,
            "expressionToEvaluate": "return window.location.href",
            "isCode": true,
            "type": "Custom"
          },
          "outgoingEdgeId": "e-init"
        }
      ]
