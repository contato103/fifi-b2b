      "graphCoordinates": {
        "x": 1360,
        "y": 0
      },
      "blocks": [
        {
          "id": "b-tel-q",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Qual o seu WhatsApp com DDD?"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "b-tel-in",
          "type": "text input",
          "options": {
            "labels": {
              "placeholder": "(47) 99999-9999",
              "button": "Enviar"
            },
            "variableId": "v_whatsapp",
            "isLong": false
          }
        },
        {
          "id": "b-tel-check",
          "type": "Set variable",
          "options": {
            "variableId": "v_tel_valido",
            "isExecutedOnClient": true,
            "expressionToEvaluate": "var d=(\"\"+({{whatsapp}}||\"\")).replace(/\\D/g,\"\");if(d.length>=12&&d.indexOf(\"55\")===0)d=d.slice(2);return (d.length===10||d.length===11)?\"sim\":\"nao\";",
            "isCode": true,
            "type": "Custom"
          }
        },
        {
          "id": "b-tel-cond",
          "outgoingEdgeId": "e-tel-erro",
          "type": "Condition",
          "items": [
            {
              "id": "tel-sim",
              "outgoingEdgeId": "e-tel",
              "content": {
                "logicalOperator": "AND",
                "comparisons": [
                  {
                    "id": "tel-sim-cmp",
                    "variableId": "v_tel_valido",
                    "comparisonOperator": "Equal to",
                    "value": "sim"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
